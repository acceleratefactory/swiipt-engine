{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiipt.com/mae/schemas/asset-record.schema.json",
  "title": "MAE AssetRecord",
  "description": "The governed identity of one approved creative expression (S9 §9.55). Approval belongs to the specific approved version. An asset is never approved by association.",
  "type": "object",
  "required": ["id", "class", "asset_version", "product_id", "angle_id", "angle_verdict", "asset_type", "asset_role", "platform", "asset_purpose", "asset_brief_id", "generation_record_id", "qa_record_id", "weighting_profile", "source_truth_refs", "family_role", "emotional_intensity", "cta_level", "content", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^AST-" },
    "class": { "const": "asset_record" },
    "asset_version": { "type": "integer", "minimum": 1 },
    "product_id": { "type": "string", "minLength": 1 },
    "transformation_id": { "type": ["string", "null"] },
    "family_id": { "type": ["string", "null"] },
    "angle_id": { "type": "string", "pattern": "^ANG-" },
    "angle_verdict": { "enum": ["GREEN", "YELLOW", "RED"] },
    "angle_version": { "type": "integer", "minimum": 1 },
    "asset_type": { "type": "string", "minLength": 1 },
    "asset_role": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "platform_format": { "type": ["string", "null"] },
    "asset_purpose": { "type": "string", "minLength": 1 },
    "weighting_profile": { "type": "object", "additionalProperties": true },
    "asset_brief_id": { "type": "string", "pattern": "^BRIEF-" },
    "visual_grounding_block_id": { "type": ["string", "null"] },
    "template_version": { "type": ["string", "null"] },
    "locked_phrase_set_id": { "type": ["string", "null"] },
    "generation_record_id": { "type": "string", "pattern": "^GEN-" },
    "qa_record_id": { "type": "string", "pattern": "^QA-" },
    "human_review_record_id": { "type": ["string", "null"] },
    "manual_override_record_id": { "type": ["string", "null"] },
    "media_artifact_ids": { "type": "array", "items": { "type": "string" } },
    "content": { "type": "string", "minLength": 1 },
    "content_hash": { "type": ["string", "null"] },
    "source_truth_refs": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "product": { "type": "array", "items": { "type": "string" } },
        "customer": { "type": "array", "items": { "type": "string" } },
        "market": { "type": "array", "items": { "type": "string" } },
        "brand_truth_version": { "type": ["string", "null"] }
      }
    },
    "family_role": { "enum": ["IDENTIFICATION", "PROBLEM", "STORY", "EDUCATION", "MECHANISM", "MYTH_REFRAME", "OBJECTION", "PROOF", "TRANSFORMATION", "CONVERSION", "REINFORCEMENT", "DECLARATION"] },
    "emotional_intensity": { "enum": ["high", "medium", "low", "conversion"] },
    "cta_level": { "enum": ["NO_CTA", "SOFT_CTA", "SAVE_SHARE_CTA", "LEARN_MORE_CTA", "PRODUCT_CTA", "DIRECT_CONVERSION_CTA"] },
    "proof_requirement": { "type": ["string", "null"] },
    "sequence_eligibility": { "type": "array", "items": { "type": "string" } },
    "evergreen_eligibility": { "type": "boolean" },
    "status": { "enum": ["APPROVED", "SCHEDULED", "PUBLISHED", "PAUSED", "RETIRED", "RE_VERIFICATION_REQUIRED", "REJECTED"] },
    "created_at": { "type": "string", "format": "date-time" },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "retired_at": { "type": ["string", "null"], "format": "date-time" },
    "usage_ids": { "type": "array", "items": { "type": "string" } },
    "dependency_refs": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "performance_refs": { "type": "array", "items": { "type": "string" } },
    "retirement_reason": { "type": ["string", "null"] },
    "re_verification_status": { "type": ["string", "null"] }
  }
}
