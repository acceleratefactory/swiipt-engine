{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiipt.com/mae/schemas/video-asset-spec.schema.json",
  "title": "MAE VideoAssetSpecification",
  "description": "The deterministic contract for one video asset (one or more shots) inside the existing media production subsystem. Text/logo/captions default to deterministic overlay (never model-rendered).",
  "type": "object",
  "additionalProperties": false,
  "required": ["video_asset_id", "angle_id", "video_grounding_id", "video_type", "platform", "placement", "aspect_ratio", "width", "height", "duration_seconds", "fps", "loop", "audio_policy", "caption_policy", "text_overlay_policy", "logo_policy", "shot_count", "shots", "safe_zones", "delivery_format", "production_mode", "reference_assets", "status"],
  "properties": {
    "video_asset_id": { "type": "string", "pattern": "^VID-" },
    "angle_id": { "type": "string", "pattern": "^ANG-" },
    "video_grounding_id": { "type": "string", "pattern": "^VG-" },
    "video_type": { "enum": ["SCENE_VIDEO", "PRODUCT_DEMO", "EDUCATIONAL_MOTION", "UI_DEMO", "TESTIMONIAL_STYLE", "KINETIC_TYPOGRAPHY", "SOCIAL_SHORT", "LANDING_PAGE_HERO_VIDEO", "BROLL", "VIDEO_AD", "EXPLAINER_SEQUENCE"] },
    "platform": { "type": "string", "minLength": 1 },
    "placement": { "type": "string", "minLength": 1 },
    "aspect_ratio": { "type": "string", "pattern": "^\\d+:\\d+$" },
    "width": { "type": "integer", "exclusiveMinimum": 0 },
    "height": { "type": "integer", "exclusiveMinimum": 0 },
    "duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "fps": { "type": "integer", "exclusiveMinimum": 0 },
    "loop": { "type": "boolean" },
    "audio_policy": { "enum": ["NONE", "AMBIENCE", "MUSIC", "VOICEOVER", "DIALOGUE"] },
    "caption_policy": { "enum": ["NONE", "DETERMINISTIC"] },
    "text_overlay_policy": { "enum": ["NONE", "DETERMINISTIC"] },
    "logo_policy": { "enum": ["NONE", "DETERMINISTIC"] },
    "shot_count": { "type": "integer", "minimum": 1 },
    "shots": { "type": "array", "minItems": 1, "items": { "$ref": "https://swiipt.com/mae/schemas/shot-spec.schema.json" } },
    "safe_zones": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "delivery_format": { "type": "string", "minLength": 1 },
    "production_mode": { "enum": ["GENERATED_SCENE", "IMAGE_TO_VIDEO", "DETERMINISTIC_MOTION", "HYBRID"] },
    "reference_assets": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["DRAFT", "READY", "SUPERSEDED"] }
  }
}
