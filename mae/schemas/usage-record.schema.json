{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiipt.com/mae/schemas/usage-record.schema.json",
  "title": "MAE UsageRecord",
  "description": "One scheduled or published use of an approved asset (S9 §9.20/§9.57). Asset identity is separate from usage identity; performance attaches to the usage.",
  "type": "object",
  "required": ["id", "class", "asset_id", "asset_version", "family_id", "angle_id", "sequence_type", "audience_state", "platform", "cta_level", "emotional_intensity", "status", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^USE-" },
    "class": { "const": "usage_record" },
    "asset_id": { "type": "string", "pattern": "^AST-" },
    "asset_version": { "type": "integer", "minimum": 1 },
    "family_id": { "type": "string", "pattern": "^FAM-" },
    "angle_id": { "type": "string", "pattern": "^ANG-" },
    "campaign_id": { "type": ["string", "null"] },
    "sequence_id": { "type": ["string", "null"] },
    "sequence_type": { "enum": ["LAUNCH", "NURTURE", "RETARGETING", "RE_ENGAGEMENT"] },
    "audience_state": { "type": "string" },
    "sequence_role": { "type": ["string", "null"] },
    "platform": { "type": "string" },
    "scheduled_at": { "type": ["string", "null"] },
    "published_at": { "type": ["string", "null"] },
    "cta_level": { "type": "string" },
    "emotional_intensity": { "type": "string" },
    "status": { "enum": ["SCHEDULED", "PUBLISHED", "CANCELLED", "REPLACED"] },
    "published_reference": { "type": ["string", "null"] },
    "performance_reference": { "type": ["string", "null"] },
    "publication_difference": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "overridden_by": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
