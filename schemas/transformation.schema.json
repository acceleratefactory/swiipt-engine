{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiipt.com/factory/schemas/transformation.schema.json",
  "title": "Swiipt Transformation Specification",
  "description": "Canonical transformation-level contract. Derived from Swiipt Transformation Product Factory Standard v1 sections 4 (specification definition), 5 (canonical record), 6 (validation rule), 26 (TSM standard), 3 (research disposition roles) and Gate 1/Gate 2/Gate 4 requirements. Structure is checked here; depth/quality is judged by the validator agent against /standards/, never by this schema.",
  "type": "object",
  "required": [
    "transformation_id",
    "library_id",
    "submarket_id",
    "status",
    "situation",
    "before_state",
    "after_state",
    "mechanism",
    "transformation_path",
    "failure_point_map",
    "first_win",
    "tsm",
    "maintenance"
  ],
  "additionalProperties": false,
  "properties": {
    "transformation_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable unique id. Naming convention fixed when the record store lands (factory build item 4)."
    },
    "library_id": {
      "type": "string",
      "minLength": 1,
      "description": "Parent library / life-area id (Standard v1 section 7.2 hierarchy)."
    },
    "submarket_id": {
      "type": "string",
      "minLength": 1,
      "description": "Submarket within the library (situation hierarchy step 2, section 4.2)."
    },
    "status": {
      "enum": ["research", "candidate", "validated", "active", "retired"],
      "description": "Section 5. 'validated' or beyond is required before any product specification may reference it (Gate 2)."
    },
    "situation": {
      "type": "object",
      "description": "Mandatory situation hierarchy (sections 4.2 and Gate 1). Every field required and non-empty: if the title were removed, these fields alone must describe the exact woman, moment, problem, failed attempt, stake and want.",
      "additionalProperties": false,
      "required": [
        "life_state",
        "person",
        "specific_situation",
        "timeframe",
        "trigger",
        "problem",
        "failed_attempt",
        "constraints",
        "emotional_stake",
        "desired_transformation"
      ],
      "properties": {
        "life_state": { "type": "string", "minLength": 1 },
        "person": { "type": "string", "minLength": 1 },
        "specific_situation": { "type": "string", "minLength": 1 },
        "timeframe": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "problem": { "type": "string", "minLength": 1 },
        "failed_attempt": { "type": "string", "minLength": 1 },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "emotional_stake": { "type": "string", "minLength": 1 },
        "desired_transformation": { "type": "string", "minLength": 1 }
      }
    },
    "before_state": {
      "type": "object",
      "description": "Section 5 before-state block. All seven facets must exist (may be empty arrays only while status is 'research').",
      "additionalProperties": false,
      "required": [
        "current_behavior",
        "current_conditions",
        "emotional_state",
        "practical_consequences",
        "failed_attempts",
        "environmental_constraints",
        "people_involved"
      ],
      "properties": {
        "current_behavior": { "type": "array", "items": { "type": "string" } },
        "current_conditions": { "type": "array", "items": { "type": "string" } },
        "emotional_state": { "type": "array", "items": { "type": "string" } },
        "practical_consequences": { "type": "array", "items": { "type": "string" } },
        "failed_attempts": { "type": "array", "items": { "type": "string" } },
        "environmental_constraints": { "type": "array", "items": { "type": "string" } },
        "people_involved": { "type": "array", "items": { "type": "string" } }
      }
    },
    "after_state": {
      "type": "object",
      "description": "Section 5 after-state block.",
      "additionalProperties": false,
      "required": [
        "new_capabilities",
        "improvements",
        "systems_created",
        "remaining_limits",
        "evidence_of_change"
      ],
      "properties": {
        "new_capabilities": { "type": "array", "items": { "type": "string" } },
        "improvements": { "type": "array", "items": { "type": "string" } },
        "systems_created": { "type": "array", "items": { "type": "string" } },
        "remaining_limits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Honesty field: what will NOT change. Required by evidence integrity (Test K spirit, section 15)."
        },
        "evidence_of_change": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Observable change signals. Validation rule 8 (section 6): without this the record is candidate-only."
        }
      }
    },
    "mechanism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_mechanism", "mechanisms", "why_it_should_work", "evidence_basis"],
      "properties": {
        "core_mechanism": { "type": "string", "minLength": 1 },
        "mechanisms": { "type": "array", "items": { "type": "string" } },
        "why_it_should_work": { "type": "string", "minLength": 1 },
        "evidence_basis": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_claim" }
        }
      }
    },
    "transformation_path": {
      "type": "array",
      "minItems": 1,
      "description": "Implementable sequence, not an information pile (validation rule 7; Test F).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "objective", "customer_action", "required_assets"],
        "properties": {
          "stage": { "type": "string", "minLength": 1 },
          "objective": { "type": "string", "minLength": 1 },
          "customer_action": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "required_assets": {
            "type": "array",
            "items": { "type": "string", "description": "asset_id references into the product's asset map." }
          }
        }
      }
    },
    "failure_point_map": {
      "type": "array",
      "minItems": 1,
      "description": "Section 5 + Test H/I: the system must work on a bad day. Each failure needs a concrete rescue.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["failure_type", "scenario", "rescue_protocol"],
        "properties": {
          "failure_type": { "type": "string", "minLength": 1 },
          "scenario": { "type": "string", "minLength": 1 },
          "rescue_protocol": { "type": "string", "minLength": 1 }
        }
      }
    },
    "first_win": {
      "type": "object",
      "description": "Section 8: immediate value within approximately 5-15 minutes (Test G).",
      "additionalProperties": false,
      "required": ["time_limit_minutes", "action", "observable_change"],
      "properties": {
        "time_limit_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 15,
          "default": 15
        },
        "action": { "type": "string", "minLength": 1 },
        "observable_change": { "type": "string", "minLength": 1 }
      }
    },
    "tsm": {
      "type": "object",
      "description": "Sections 5 and 26 combined: TSM measures real before-to-after movement, never engagement. All seven section-26 elements are required.",
      "additionalProperties": false,
      "required": [
        "before_baseline",
        "success_indicators",
        "measurement_days",
        "success_threshold",
        "measurement_method",
        "incomplete_progress_interpretation",
        "next_action_on_miss"
      ],
      "properties": {
        "before_baseline": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "success_indicators": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "measurement_days": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "default": [0, 7, 14, 30],
          "description": "Default Day 0/7/14/30 (section 26); another schedule is allowed."
        },
        "success_threshold": {
          "type": "string",
          "minLength": 1,
          "description": "Business call - owner approves (human authority, section 21)."
        },
        "measurement_method": { "type": "string", "minLength": 1 },
        "incomplete_progress_interpretation": {
          "type": "string",
          "minLength": 1,
          "description": "Section 26 item 6: how incomplete progress is interpreted."
        },
        "next_action_on_miss": {
          "type": "string",
          "minLength": 1,
          "description": "Section 26 item 7: what happens next if progress is missed."
        }
      }
    },
    "maintenance": {
      "type": "object",
      "description": "Section 5 maintenance block (re-entry and relapse included).",
      "additionalProperties": false,
      "required": ["maintenance_system", "relapse_protocol", "reentry_protocol"],
      "properties": {
        "maintenance_system": { "type": "string", "minLength": 1 },
        "relapse_protocol": { "type": "string", "minLength": 1 },
        "reentry_protocol": { "type": "string", "minLength": 1 }
      }
    },
    "next_transformation": {
      "type": "array",
      "description": "Journey routing (Test O, ecosystem rule section 23). May be empty ONLY with an explicit reason recorded in evidence/notes during backfill; new validations require at least one entry or a documented 'none yet' reason (deterministic content test, section 14).",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_claim" }
    },
    "safety": {
      "type": "object",
      "description": "Safety boundary (validation rule 9; Gate 5).",
      "additionalProperties": false,
      "required": ["risk_level", "scope_boundary", "red_flags", "escalation_rules"],
      "properties": {
        "risk_level": { "enum": ["low", "moderate", "high", "clinical"] },
        "scope_boundary": {
          "type": "string",
          "minLength": 1,
          "description": "What this transformation deliberately does NOT cover (competence boundary, Test L)."
        },
        "red_flags": { "type": "array", "items": { "type": "string" } },
        "escalation_rules": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Must route to the verified shared crisis/escalation list - never invented numbers."
        }
      }
    },
    "research_disposition": {
      "type": "object",
      "description": "Gate 0 outcome. No unclassified research proceeds (section 19). There is no DISCARD role.",
      "additionalProperties": false,
      "required": ["library_role", "rationale"],
      "properties": {
        "library_role": {
          "enum": [
            "STANDALONE_TRANSFORMATION",
            "ENTRY_PRODUCT",
            "UPSELL",
            "ORDER_BUMP",
            "BUNDLE_COMPONENT",
            "MODULE",
            "BONUS_FREE_GIFT",
            "LEAD_MAGNET",
            "MARKETING_ANGLE",
            "SUPPORTING_ASSET",
            "JOURNEY_NODE",
            "FUTURE_RESEARCH",
            "EVIDENCE_GAP"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "assigned_at": { "type": "string", "format": "date" },
        "reclassification_history": {
          "type": "array",
          "description": "A finding can be reclassified as new evidence arrives (section 3); history is kept, never erased.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from_role", "to_role", "reason", "date"],
            "properties": {
              "from_role": { "type": "string" },
              "to_role": { "type": "string" },
              "reason": { "type": "string" },
              "date": { "type": "string", "format": "date" }
            }
          }
        }
      }
    },
    "applicability": {
      "type": "object",
      "description": "ANALYTICAL applicability determination (task research-pipeline V1). Distinct from DESCRIPTIVE provenance: it records whether the transformation contract materially depends on geography/culture/jurisdiction. UNIVERSAL_CORE = no identified material dependency; CONTEXT_VARIABLE = same canonical transformation with context-aware delivery; CONTEXT_INTRINSIC = culture/geography/jurisdiction materially defines the contract.",
      "additionalProperties": false,
      "required": ["classification", "basis"],
      "properties": {
        "classification": { "enum": ["UNIVERSAL_CORE", "CONTEXT_VARIABLE", "CONTEXT_INTRINSIC"] },
        "basis": { "type": "string", "minLength": 1 },
        "intrinsic_dimensions": { "type": "array", "items": { "type": "string" } },
        "context_variables": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "uncertainty": { "type": "string" },
        "unresolved_questions": { "type": "array", "items": { "type": "string" } },
        "classification_source": { "enum": ["declared", "derived"] },
        "source_context": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "description": "Governed candidate -> validated transition record (Phase J). Written only by harness/validate-transformation.mjs after the canonical validation conditions are met. It authorizes the transformation boundary only and never implies clinical, evidence, safety or publication approval.",
      "additionalProperties": false,
      "required": ["status", "validated_by", "validated_at", "source_state", "target_state", "authority"],
      "properties": {
        "status": { "enum": ["validated"] },
        "validated_by": { "type": "string", "minLength": 1 },
        "validated_at": { "type": "string", "format": "date-time" },
        "source_state": { "type": "string", "minLength": 1 },
        "target_state": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string" },
        "not_implying": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "description": "DESCRIPTIVE research provenance carried onto the transformation (source/population/geography/limitations). Never defines identity or applicability.",
      "additionalProperties": false,
      "properties": {
        "source_label": { "type": ["string", "null"] },
        "source_date": { "type": ["string", "null"] },
        "population": { "type": ["string", "null"] },
        "geography": { "type": ["string", "null"] },
        "jurisdiction": { "type": ["string", "null"] },
        "cultural_context": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "evidence_status": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "evidence_claim": {
      "type": "object",
      "description": "Claim-status model from Gate 4: clinical facts and thresholds cannot be invented.",
      "additionalProperties": false,
      "required": ["claim", "status"],
      "properties": {
        "claim": { "type": "string", "minLength": 1 },
        "status": {
          "enum": [
            "sourced_evidence",
            "expert_reviewed",
            "lived_experience",
            "model_inference",
            "hypothesis"
          ]
        },
        "source": {
          "type": "string",
          "description": "Citation or provenance pointer. Required when status is sourced_evidence or expert_reviewed (enforced below)."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "enum": ["sourced_evidence", "expert_reviewed"] } }
          },
          "then": { "required": ["source"] }
        }
      ]
    }
  }
}
