# Swiipt provider configuration — PLACEHOLDERS ONLY. Never commit real values.
#
# Every external capability is DORMANT until a key is set. Deterministic paths always work with
# no keys, no network, and no credentials. A missing provider produces an explicit status
# (PROVIDER_NOT_CONFIGURED / PRODUCTION_BLOCKED / RENDER_PENDING_EXTERNAL_PROVIDER / NOT_RUN),
# never a fake result.

# --- Factory / Writing Control (OpenAI-compatible text + reasoning) ---
COPYWRITER_PROVIDER=            # deterministic (default) | openai
WRITING_CRITIC_PROVIDER=        # none (default) | openai
OPENAI_BASE_URL=                # optional; default https://api.openai.com/v1 (OpenAI-compatible gateways supported)
OPENAI_API_KEY=
OPENAI_MODEL=                   # shared fallback model when a worker var is unset (default gpt-4o-mini)
COPYWRITER_MODEL=               # overrides OPENAI_MODEL for the copywriter
WRITING_CRITIC_MODEL=           # overrides OPENAI_MODEL for the writing critic
OPENAI_TIMEOUT_MS=              # optional request timeout in ms (default 60000)

# --- MAE (recognized by the shared model resolver; adapters stay dormant behind their interfaces) ---
MAE_GENERATION_MODEL=
MAE_CRITIC_MODEL=
MAE_CRITIC_API_KEY=
MAE_IMAGE_API_KEY=
MAE_VIDEO_API_KEY=
MAE_TTS_API_KEY=
